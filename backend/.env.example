# =============================================================================
# REQUIRED — ESP32 hazard ingestion will NOT work without these two vars
# =============================================================================
#
#   PORT           — port the backend listens on; the firmware must POST to:
#                    http://<LAN_IP>:<PORT>/api/hazard-report
#
#   ML_SERVICE_URL — URL of the Python AI microservice.  Ingestion continues
#                    with a rule-based fallback classifier even when this
#                    service is down — it is NOT a hard dependency.
#
PORT=5000
ML_SERVICE_URL=http://localhost:8000

# =============================================================================
# OPTIONAL — Firebase (cloud Firestore + Storage)
# When ALL four FIREBASE_* vars are empty the backend silently falls back to
# local disk (data/hazards.json + uploads/).  ESP32 ingestion works in both modes.
# =============================================================================
# Get these from: Firebase Console → Project Settings → Service Accounts
#                 → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key exactly as in the downloaded JSON (keep the \n escapes)
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# =============================================================================
# OPTIONAL — Gemini AI narrative generation
# Used by the AI worker to enrich hazard records with a text summary.
# Ingestion works without it; the ai_report field will simply be null.
# =============================================================================
GEMINI_API_KEY=

# =============================================================================
# OPTIONAL — Telegram emergency alert bot
# =============================================================================
# 1. Create bot: message @BotFather on Telegram → /newbot
# 2. Get chat ID: message @userinfobot or use the getUpdates API
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# =============================================================================
# INFORMATIONAL — no action needed in most cases
# =============================================================================
NODE_ENV=development
