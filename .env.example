# =================================================================
# Smart Civic Hazard Monitoring Rover — Global Environment Config
# =================================================================

# ── Backend Configuration ─────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# ── ML Microservice ───────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_PORT=8000
YOLO_WEIGHTS_PATH=ml-pipeline/weights/best.pt
N_CLUSTERS=5

# ── Firebase Admin SDK (Optional - Local storage used if blank) ───
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ── Telegram Emergency Alerts (Optional) ──────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ── Generative AI Municipal Reports (Optional) ───────────────────
GEMINI_API_KEY=.Ab8RN6K_daY3f-8DcBGZoDkZiQf8gvdKJo3j2Vd-qtk85pQCAw
AQ
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Frontend Dashboard (Vite) ─────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_MAPS_API_KEY=
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-rover-project
VITE_FIREBASE_STORAGE_BUCKET=demo-rover-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
